---
<section id="skills">
    <div class="section-label">What I work with</div>
    <h2>Skills &amp;<br/>Technologies</h2>
    {categories.map(category => (
        <div class="skill-category">
            <h3 class="category-label">{category.name}</h3>
            <div class="skills-grid reveal">
                {category.skills.map(skill => (
                    <div class="skill-card">
                        <div class="skill-icon">{skill.icon}</div>
                        <div class="skill-name">{skill.name}</div>
                        <div class="skill-level">
                            <span>{skill.level}</span>
                            <div class="skill-bar"><div class="skill-fill" data-w={skill.width}></div></div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    ))}
</section>

<style>
    .skill-category {
        margin-bottom: 32px;
    }

    .category-label {
        font-family: 'DM Mono', monospace;
        font-size: .72rem;
        color: var(--accent);
        letter-spacing: .12em;
        text-transform: uppercase;
        margin-bottom: 16px;
        padding-left: 2px;
    }

    .skills-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 14px;
    }

    .skill-card {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 24px;
        transition: all .25s;
        position: relative;
        overflow: hidden;
    }

    .skill-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 2px;
        opacity: 0;
        transition: opacity .25s;
    }

    .skill-card:hover { border-color: var(--accent); transform: translateY(-4px); box-shadow: 0 12px 40px color-mix(in srgb, var(--accent), transparent 92%); }
    .skill-card:hover::before { opacity: 1; background: var(--accent); }

    .skill-icon { font-size: 1.5rem; margin-bottom: 12px; }
    .skill-name { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 1rem; margin-bottom: 6px; }
    .skill-level {
        font-family: 'DM Mono', monospace;
        font-size: .72rem;
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .skill-bar {
        flex: 1;
        height: 3px;
        background: var(--line);
        border-radius: 2px;
        overflow: hidden;
    }

    .skill-fill {
        height: 100%;
        background: var(--accent);
        border-radius: 2px;
        width: 0;
        transition: width 1s ease;
    }
</style>
