---
const skills = [
    { name: 'React', icon: '⚛️', level: 'Advanced', width: 80 },
    { name: 'Tailwind CSS', icon: '🎨', level: 'Advanced', width: 82 },
    { name: 'Docker', icon: '🐳', level: 'Intermediate', width: 60 },
    { name: 'GitHub Actions', icon: '⚙️', level: 'Intermediate', width: 65 },
    { name: 'HTML / CSS', icon: '🌐', level: 'Advanced', width: 88 },
    { name: 'Trading / Fintech', icon: '📈', level: 'Learning', width: 42 },
    { name: 'Git', icon: '🔧', level: 'Advanced', width: 78 },
    { name: 'JavaScript', icon: '🟨', level: 'Intermediate', width: 70 },
];
---
<section id="skills">
    <div class="section-label">What I work with</div>
    <h2>Skills &amp;<br/>Technologies</h2>
    <div class="skills-grid reveal">
        {skills.map(skill => (
            <div class="skill-card">
                <div class="skill-icon">{skill.icon}</div>
                <div class="skill-name">{skill.name}</div>
                <div class="skill-level">
                    <span>{skill.level}</span>
                    <div class="skill-bar"><div class="skill-fill" data-w={skill.width}></div></div>
                </div>
            </div>
        ))}
    </div>
</section>

<style>
    .skills-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 16px;
    }

    .skill-card {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 24px;
        transition: all .25s;
        position: relative;
        overflow: hidden;
    }

    .skill-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 2px;
        opacity: 0;
        transition: opacity .25s;
    }

    .skill-card:hover { border-color: var(--accent); transform: translateY(-4px); box-shadow: 0 12px 40px color-mix(in srgb, var(--accent), transparent 92%); }
    .skill-card:hover::before { opacity: 1; background: var(--accent); }

    .skill-icon { font-size: 1.5rem; margin-bottom: 12px; }
    .skill-name { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 1rem; margin-bottom: 6px; }
    .skill-level {
        font-family: 'DM Mono', monospace;
        font-size: .72rem;
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .skill-bar {
        flex: 1;
        height: 3px;
        background: var(--line);
        border-radius: 2px;
        overflow: hidden;
    }

    .skill-fill {
        height: 100%;
        background: var(--accent);
        border-radius: 2px;
        width: 0;
        transition: width 1s ease;
    }
</style>
