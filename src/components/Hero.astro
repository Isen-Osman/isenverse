---
---
<section id="hero" style="max-width:100%;padding:120px 48px 80px;">
    <div class="hero-glow"></div>
    <div class="hero-glow2"></div>
    <div class="hero-inner">
        <div class="hero-tag">Available for opportunities</div>
        <h1>
            <span class="hi">Hello, I'm</span>
            <span class="name">Isen<span class="accent">.</span></span>
            <span class="typewriter" id="typewriter"></span>
        </h1>
        <p class="hero-bio">
            Software engineering student building at the intersection of
            <em>modern web development</em> and <em>financial technology</em>.
            Clean code, clean UI — always.
        </p>
        <div class="hero-cta">
            <a href="#projects" class="btn btn-primary">View Projects</a>
            <a href="#contact" class="btn btn-ghost">Get in touch</a>
        </div>
    </div>
</section>

<style>
    #hero {
        min-height: 100vh;
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
    }

    .hero-glow {
        position: absolute;
        width: 700px; height: 700px;
        border-radius: 50%;
        background: radial-gradient(circle, #7cffd415 0%, transparent 70%);
        top: -150px; right: -200px;
        pointer-events: none;
        animation: pulse 6s ease-in-out infinite;
    }

    .hero-glow2 {
        position: absolute;
        width: 400px; height: 400px;
        border-radius: 50%;
        background: radial-gradient(circle, #4f8eff10 0%, transparent 70%);
        bottom: 50px; left: -100px;
        pointer-events: none;
        animation: pulse 8s ease-in-out infinite reverse;
    }

    @keyframes pulse {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.08); opacity: .7; }
    }

    .hero-inner { max-width: 900px; }

    .hero-tag {
        font-family: 'DM Mono', monospace;
        font-size: .75rem;
        color: var(--accent);
        letter-spacing: .15em;
        text-transform: uppercase;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 10px;
        opacity: 0;
        animation: fadeUp .6s ease forwards .1s;
    }

    .hero-tag::before {
        content: '';
        display: block;
        width: 32px; height: 1px;
        background: var(--accent);
    }

    h1 {
        font-family: 'Syne', sans-serif;
        font-size: clamp(3rem, 8vw, 6.5rem);
        font-weight: 800;
        line-height: 1;
        letter-spacing: -.03em;
        margin-bottom: 28px;
        opacity: 0;
        animation: fadeUp .7s ease forwards .25s;
    }

    h1 .hi { display: block; color: var(--muted); font-size: .55em; font-weight: 400; letter-spacing: -.01em; margin-bottom: 8px; }
    h1 .name { color: var(--text); }
    h1 .accent { color: var(--accent); }

    .typewriter {
        display: block;
        font-size: 0.35em;
        color: var(--accent);
        font-family: 'DM Mono', monospace;
        margin-top: 10px;
        min-height: 1.2em;
    }

    .typewriter::after {
        content: '|';
        animation: blink 1s infinite;
    }

    @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

    .hero-bio {
        max-width: 520px;
        color: var(--muted);
        font-size: 1.05rem;
        line-height: 1.75;
        margin-bottom: 40px;
        opacity: 0;
        animation: fadeUp .7s ease forwards .4s;
    }

    .hero-cta {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        opacity: 0;
        animation: fadeUp .7s ease forwards .55s;
    }

    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 768px) {
        #hero { padding: 120px 24px 60px !important; }
    }
</style>

<script>
    const textArr = ["Software Engineer", "Fintech Enthusiast", "Market Trader", "Web Architect"];
    let idx = 0;
    let charIdx = 0;
    let isDeleting = false;
    const el = document.getElementById('typewriter');

    function type() {
        if (!el) return;
        const currentText = textArr[idx];
        
        if (isDeleting) {
            el.textContent = currentText.substring(0, charIdx - 1);
            charIdx--;
        } else {
            el.textContent = currentText.substring(0, charIdx + 1);
            charIdx++;
        }

        let speed = isDeleting ? 50 : 100;

        if (!isDeleting && charIdx === currentText.length) {
            isDeleting = true;
            speed = 2000; // Pause at end
        } else if (isDeleting && charIdx === 0) {
            isDeleting = false;
            idx = (idx + 1) % textArr.length;
            speed = 500;
        }

        setTimeout(type, speed);
    }

    setTimeout(type, 1000);
</script>
