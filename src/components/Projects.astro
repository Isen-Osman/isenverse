---
const projects = [
    {
        num: '01',
        title: 'Financial Tracker',
        desc: 'A full-featured personal finance application to track income, expenses, and investment performance. Clean dashboard with real-time charts, category breakdowns, and relational database storage.',
        tags: ['Spring Boot', 'React', 'PostgreSQL', 'REST API']
    },
    {
        num: '02',
        title: 'CI/CD Pipeline',
        desc: 'Automated deployment pipeline using GitHub Actions — linting, Docker image building, pushing to Docker Hub, and deploying to GitHub Pages in a single workflow. Containerized with multi-stage builds.',
        tags: ['Docker', 'GitHub Actions', 'Kubernetes', 'CI/CD']
    },
    {
        num: '03',
        title: 'Portfolio Website',
        desc: 'Modern single-page portfolio built with Astro — static site generation, dark/light theme, responsive design, scroll animations, and deployed via GitHub Pages with Docker fallback.',
        tags: ['Astro', 'HTML/CSS', 'Docker', 'GitHub Pages']
    }
];
---
<section id="projects">
    <div class="section-label">What I've built</div>
    <h2>Featured<br/>Projects</h2>
    <div class="projects-grid reveal">
        {projects.map(project => (
            <div class="project-card">
                <div class="project-num">{project.num}</div>
                <div class="project-title">{project.title}</div>
                <p class="project-desc">{project.desc}</p>
                <div class="project-tags">
                    {project.tags.map(tag => (
                        <span class="tag">{tag}</span>
                    ))}
                </div>
            </div>
        ))}
    </div>
</section>

<style>
    .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 24px;
    }

    @media (max-width: 768px) {
        .projects-grid {
            display: flex;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            padding-bottom: 24px;
            margin-left: -24px;
            margin-right: -24px;
            padding-left: 24px;
            padding-right: 24px;
            scrollbar-width: none; /* Hide scrollbar Firefox */
        }
        .projects-grid::-webkit-scrollbar {
            display: none; /* Hide scrollbar Chrome/Safari */
        }
        .project-card {
            min-width: 85vw;
            scroll-snap-align: center;
        }
    }

    .project-card {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 32px;
        transition: all .25s;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .project-card:hover { border-color: var(--accent2); transform: translateY(-6px); box-shadow: 0 20px 60px color-mix(in srgb, var(--accent2), transparent 94%); }

    .project-img {
        font-family: 'DM Mono', monospace;
        font-size: .7rem;
        color: var(--muted);
        letter-spacing: .1em;
    }

    .project-title {
        font-family: 'Syne', sans-serif;
        font-weight: 700;
        font-size: 1.25rem;
        letter-spacing: -.01em;
    }

    .project-desc {
        color: var(--muted);
        font-size: .9rem;
        line-height: 1.65;
        flex: 1;
    }

    .project-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .tag {
        font-family: 'DM Mono', monospace;
        font-size: .68rem;
        letter-spacing: .06em;
        padding: 4px 10px;
        border-radius: 4px;
        border: 1px solid var(--line);
        color: var(--muted);
    }
</style>

<script>
    const cards = document.querySelectorAll('.project-card');
    cards.forEach(card => {
        card.addEventListener('mousemove', (e: any) => {
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;
            
            const rotateX = (y - centerY) / 10;
            const rotateY = (centerX - x) / 10;
            
            (card as HTMLElement).style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-6px)`;
        });
        
        card.addEventListener('mouseleave', () => {
            (card as HTMLElement).style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0)`;
        });
    });
</script>
